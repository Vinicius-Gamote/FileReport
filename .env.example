# Copy to .env and fill all three secrets before running docker compose up.
# Generate separate random values (at least 32 bytes each); never commit .env.
# Existing databases/brokers require their original passwords; do not rotate them here.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SIGNING_KEY=
EMAIL_MODE=Fake
RESEND_API_KEY=
EMAIL_FROM=FileReport <reports@example.test>
REPORT_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
